# ─── Rivox environment variables (copy to .env and fill in) ───────────────

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Analytics (GA4) — your Measurement ID like G-ABC123XYZ45
# Traffic is only tracked when a real ID is set here (no placeholder loads).
VITE_GA_MEASUREMENT_ID=

# Paddle checkout
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_PRO_MONTHLY_PRICE_ID=
VITE_PADDLE_PRO_YEARLY_PRICE_ID=
VITE_PADDLE_BUSINESS_MONTHLY_PRICE_ID=
VITE_PADDLE_BUSINESS_YEARLY_PRICE_ID=

# Server-side only (never prefix with VITE_)
PADDLE_API_KEY=
